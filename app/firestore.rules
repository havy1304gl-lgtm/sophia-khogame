rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admitted() {
   return request.auth != null
    && request.auth.token.sophiaRole in ['admin','player']
    && request.auth.token.sophiaSessionUntil is number
    && request.auth.token.sophiaSessionUntil > request.time.toMillis()
    && request.auth.token.sophiaAccessVersion == get(/databases/$(database)/documents/_access/control).data.version;
  }
  function manager() { return admitted() && request.auth.token.sophiaRole == 'admin'; }
  function bankReadable(bank) { return manager() || (admitted() && bank.deletedAt == null); }
  function validBank(data) {
   return data.keys().hasAll(['title','description','folderId','createdBy','createdAt','updatedAt','version','deletedAt','payloadId','partCount','digest','questionCount'])
    && data.keys().hasOnly(['title','description','folderId','createdBy','createdAt','updatedAt','version','deletedAt','payloadId','partCount','digest','questionCount','migrationKey'])
    && data.title is string && data.title.size() > 0 && data.title.size() <= 200
    && data.description is string && data.description.size() <= 5000
    && (data.folderId == null || data.folderId is string)
    && data.createdBy is string && data.createdAt is timestamp && data.updatedAt is timestamp
    && data.version is int && data.version > 0
    && (data.deletedAt == null || data.deletedAt is string)
    && data.payloadId is string && data.payloadId.size() <= 80
    && data.partCount is int && data.partCount > 0 && data.partCount <= 1000
    && data.digest is string && data.digest.size() == 64
    && data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 500;
  }
  match /question_banks/{bankId} {
   allow read: if bankReadable(resource.data);
   allow create: if manager() && validBank(request.resource.data) && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
   allow update: if manager() && validBank(request.resource.data)
    && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.updatedAt == request.time && request.resource.data.version == resource.data.version + 1;
   allow delete: if false; // The app uses a reversible trash operation.
   match /payloads/{payloadId}/parts/{partId} {
    allow read: if bankReadable(get(/databases/$(database)/documents/question_banks/$(bankId)).data);
    allow create: if manager() && request.resource.data.keys().hasOnly(['index','text'])
     && request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.index < 1000
     && request.resource.data.text is string && request.resource.data.text.size() <= 512000;
    allow update,delete: if false; // Published versions are immutable.
   }
  }
  match /folders/{folderId} {
   allow read: if manager() || (admitted() && resource.data.deletedAt == null);
   allow create,update: if manager() && request.resource.data.keys().hasOnly(['name','parentId','deletedAt','owner'])
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
    && (request.resource.data.parentId == null || request.resource.data.parentId is string)
    && (request.resource.data.deletedAt == null || request.resource.data.deletedAt is string)
    && request.resource.data.owner is string;
   allow delete: if false;
  }
  match /{document=**} { allow read,write: if false; }
 }
}
