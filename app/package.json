{
  "name": "sophia-games",
  "version": "0.9.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.netlify.config.ts",
    "dev:netlify": "vite --config vite.netlify.config.ts",
    "build": "vite build --config vite.netlify.config.ts",
    "build:netlify": "vite build --config vite.netlify.config.ts",
    "preview": "vite preview --config vite.netlify.config.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:offline": "vite --config vite.netlify.config.ts --mode offline",
    "test:rules": "node --experimental-strip-types --test tests/firestore.integration.mts"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "@firebase/rules-unit-testing": "6.0.0"
  },
  "type": "module",
  "overrides": {
    "uuid": "11.1.1",
    "@grpc/grpc-js": "^1.13.6"
  }
