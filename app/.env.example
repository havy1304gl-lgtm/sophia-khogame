# Public Firebase Web app config. Copy to .env.local; set these in Netlify for builds.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only settings: NEVER prefix with VITE_, never commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
SOPHIA_ADMIN_PASSWORD=
SOPHIA_PLAYER_PASSWORD=
SOPHIA_ACCESS_VERSION=v1
# Generate a random secret, at least 32 characters, for login attempt keys.
SOPHIA_RATE_LIMIT_SECRET=
