import {test,before,after} from 'node:test';
import {readFile} from 'node:fs/promises';
import {initializeTestEnvironment,assertFails,assertSucceeds,type RulesTestEnvironment} from '@firebase/rules-unit-testing';
import {collection,doc,getDoc,getDocs,setDoc,updateDoc,deleteDoc,query,where,serverTimestamp,Timestamp} from 'firebase/firestore';
let env:RulesTestEnvironment;
const claims=(role:string,extra={})=>({sophiaRole:role,sophiaSessionUntil:Date.now()+3600000,sophiaAccessVersion:'v1',...extra});
const bank=(owner:string)=>({title:'Test bank',description:'',folderId:null,createdBy:owner,createdAt:serverTimestamp(),updatedAt:serverTimestamp(),version:1,deletedAt:null,payloadId:'payload-1',partCount:1,digest:'a'.repeat(64),questionCount:1});
before(async()=>{env=await initializeTestEnvironment({projectId:'demo-sophia-rules',firestore:{host:'127.0.0.1',port:8080,rules:await readFile(new URL('../firestore.rules',import.meta.url),'utf8')}});await env.clearFirestore();await env.withSecurityRulesDisabled(async context=>{const db=context.firestore();await setDoc(doc(db,'_access/control'),{version:'v1'});await setDoc(doc(db,'question_banks/published'),{...bank('admin'),createdAt:Timestamp.now(),updatedAt:Timestamp.now()});await setDoc(doc(db,'question_banks/deleted'),{...bank('admin'),createdAt:Timestamp.now(),updatedAt:Timestamp.now(),deletedAt:new Date().toISOString()});await setDoc(doc(db,'question_banks/published/payloads/payload-1/parts/0000'),{index:0,text:'published payload'});await setDoc(doc(db,'folders/public'),{name:'Class 5',parentId:null,deletedAt:null,owner:'admin'});});});
after(async()=>{await env?.cleanup();});
test('Unsigned visitor and an ordinary Firebase user cannot read banks, payloads or private access configuration',async()=>{for(const context of [env.unauthenticatedContext(),env.authenticatedContext('ordinary-user')]){const db=context.firestore();await assertFails(getDoc(doc(db,'question_banks/published')));await assertFails(getDoc(doc(db,'question_banks/published/payloads/payload-1/parts/0000')));await assertFails(getDoc(doc(db,'_access/control')));}});
test('Player can list active banks and read payload, but cannot create/edit/trash/delete or forge permission documents',async()=>{const db=env.authenticatedContext('player',claims('player')).firestore();await assertSucceeds(getDocs(query(collection(db,'question_banks'),where('deletedAt','==',null))));await assertSucceeds(getDoc(doc(db,'question_banks/published/payloads/payload-1/parts/0000')));await assertFails(setDoc(doc(db,'question_banks/player-injected'),bank('player')));await assertFails(updateDoc(doc(db,'question_banks/published'),{title:'Hijacked',updatedAt:serverTimestamp(),version:2}));await assertFails(deleteDoc(doc(db,'question_banks/published')));await assertFails(setDoc(doc(db,'question_banks/published/payloads/evil/parts/0000'),{index:0,text:'forged'}));await assertFails(setDoc(doc(db,'_access/control'),{version:'forged'}));await assertFails(setDoc(doc(db,'users/player'),{role:'admin'}));await assertFails(setDoc(doc(db,'folders/forged'),{name:'X',parentId:null,deletedAt:null,owner:'player'}));});
test('Player cannot list all banks or open trash, while Admin sees every bank',async()=>{const db=env.authenticatedContext('p2',claims('player')).firestore();await assertFails(getDocs(collection(db,'question_banks')));await assertFails(getDoc(doc(db,'question_banks/deleted')));await assertSucceeds(getDocs(collection(env.authenticatedContext('a2',claims('admin')).firestore(),'question_banks')));});
test('Admin can publish and edit with valid metadata; published chunks are immutable',async()=>{const db=env.authenticatedContext('manager',claims('admin')).firestore();await assertSucceeds(setDoc(doc(db,'question_banks/managed/payloads/v1/parts/0000'),{index:0,text:'payload'}));await assertSucceeds(setDoc(doc(db,'question_banks/managed'),bank('manager')));await assertSucceeds(updateDoc(doc(db,'question_banks/managed'),{title:'Updated',version:2,updatedAt:serverTimestamp()}));await assertFails(updateDoc(doc(db,'question_banks/managed/payloads/v1/parts/0000'),{text:'changed in place'}));await assertFails(updateDoc(doc(db,'question_banks/managed'),{createdBy:'other',version:3,updatedAt:serverTimestamp()}));});
test('Expired, unsupported or revoked access claims cannot read or write',async()=>{for(const token of [claims('admin',{sophiaSessionUntil:Date.now()-1000}),claims('owner'),claims('admin',{sophiaAccessVersion:'revoked'})]){const db=env.authenticatedContext('rejected-'+Math.random(),token).firestore();await assertFails(getDoc(doc(db,'question_banks/published')));await assertFails(setDoc(doc(db,'question_banks/forbidden'),bank('forbidden')));}});
test('A valid Unicode payload part fits the document limit and a player still cannot replace it',async()=>{const db=env.authenticatedContext('unicode-manager',claims('admin')).firestore(),ref=doc(db,'question_banks/published/payloads/unicode/parts/0000');await assertSucceeds(setDoc(ref,{index:0,text:'Tiếng Việt 😀'.repeat(9000)}));const player=env.authenticatedContext('unicode-player',claims('player')).firestore();await assertSucceeds(getDoc(doc(player,ref.path)));await assertFails(updateDoc(doc(player,ref.path),{text:'replaced'}));});
